#!/bin/bash
# =============================================================================
# Garde légère pour rclone bisync
# -----------------------------------------------------------------------------
# Ne lance le bisync que si c'est utile, pour économiser les ressources
# (appels API Drive, bande passante, CPU) quand rien n'a changé :
#
#   1. FORCE   : un sync manuel a été demandé depuis le dashboard
#                (fichier marqueur .force-sync) -> on lance, sans condition.
#   2. LOCAL   : un fichier du dossier synchronisé a été modifié récemment
#                (fenêtre LOCAL_WINDOW minutes) -> on lance.
#   3. CLOUD   : filet de sécurité périodique pour récupérer les modifications
#                faites directement côté cloud / autre PC (configurable).
#   4. Sinon   : on ne fait rien (bisync ignoré).
# =============================================================================
set -u

CONFIG_FILE="$HOME/.config/rclone/dash-config.json"
REMOTE=$(python3 -c "import json, sys; print(json.load(sys.stdin).get('remote', 'GoogleDrive:'))" < "$CONFIG_FILE" 2>/dev/null || echo "GoogleDrive:")
SYNC_DIR=$(python3 -c "import json, sys; print(json.load(sys.stdin).get('local_dir', '~/GoogleDrive'))" < "$CONFIG_FILE" 2>/dev/null || echo "~/GoogleDrive")
SYNC_DIR="${SYNC_DIR/#\~/$HOME}"
FULL_INTERVAL=$(python3 -c "import json, sys; print(json.load(sys.stdin).get('full_sync_interval', '60'))" < "$CONFIG_FILE" 2>/dev/null || echo "60")

RCLONE_CONF="__HOME__/.config/rclone"
STAMP="$RCLONE_CONF/.last-full-sync"
FORCE_FILE="$RCLONE_CONF/.force-sync"
RESYNC_FILE="$RCLONE_CONF/.resync"
AUTO_NOTICE_FILE="$RCLONE_CONF/.auto-resync-notice"

# Fenêtre de détection d'un changement local, en minutes.
# Volontairement un peu plus large que l'intervalle du timer (10 min) pour ne
# jamais laisser passer un fichier modifié juste au bord d'une fenêtre.
LOCAL_WINDOW=12

run_bisync() {
    local is_resync="${1:-0}"
    local is_auto_resync="${2:-0}"
    local extra_args=()
    if [ "$is_resync" -eq 1 ]; then
        extra_args+=(--resync --resync-mode newer)
    fi

    mkdir -p "$RCLONE_CONF"
    # Nettoyage préventif des verrous orphelins (processus interrompu ou tué)
    local cache_dir="$HOME/.cache/rclone/bisync"
    if [ -d "$cache_dir" ]; then
        for lck in "$cache_dir"/*.lck; do
            [ -f "$lck" ] || continue
            local lck_pid
            lck_pid=$(python3 -c "import json; print(json.load(open('$lck')).get('PID', ''))" 2>/dev/null || true)
            if [ -n "$lck_pid" ] && ! kill -0 "$lck_pid" 2>/dev/null; then
                echo "RcloneDash: suppression du verrou orphelin (PID $lck_pid inactif)"
                rm -f "$lck"
            fi
        done
    fi
    local rclone_bin
    rclone_bin="$(command -v rclone 2>/dev/null || echo /usr/bin/rclone)"
    "$rclone_bin" bisync "$REMOTE" "$SYNC_DIR" \
        --config "$RCLONE_CONF/rclone.conf" \
        --filter-from "$RCLONE_CONF/gdrive-filters.txt" \
        --drive-skip-shortcuts \
        --drive-skip-gdocs \
        --tpslimit 8 \
        -v \
        --stats 5s \
        --stats-file-name-length 0 \
        --conflict-resolve newer \
        --resilient \
        "${extra_args[@]}"
    local rc=$?
    # On n'horodate le dernier sync complet que si rclone a réussi.
    if [ $rc -eq 0 ]; then
        date +%s > "$STAMP"
        if [ "$is_auto_resync" -eq 1 ]; then
            date +%s > "$AUTO_NOTICE_FILE"
        fi
    fi
    return $rc
}

is_resync=0
is_auto_resync=0
reason=""

# Bornes de la fenêtre de détection locale, au format ISO 8601 (compatible aussi
# bien GNU findutils que bfs). On considère "récent" un fichier modifié dans une
# bande [now - fenêtre, now + fenêtre] autour de l'instant présent.
#
# La borne HAUTE (now + fenêtre) est volontairement un peu dans le futur, pour
# deux raisons : (1) elle inclut les fichiers tout juste modifiés malgré la
# troncature à la seconde ; (2) elle EXCLUT les fichiers datés loin dans le futur
# (horloge reculée de plusieurs heures/mois, modtime aberrant venu du cloud) qui,
# avec un simple -mmin, auraient un "âge" négatif et seraient comptés comme
# récents — provoquant des syncs inutiles à répétition.
WIN_LO=$(date -d "$LOCAL_WINDOW minutes ago" '+%Y-%m-%dT%H:%M:%S')
WIN_HI=$(date -d "$LOCAL_WINDOW minutes"     '+%Y-%m-%dT%H:%M:%S')

# 0. Réinitialisation forcée (--resync) demandée ?
if [ "${1:-}" = "--resync" ] || [ -f "$RESYNC_FILE" ]; then
    rm -f "$RESYNC_FILE" "$FORCE_FILE"
    is_resync=1
    reason="réinitialisation forcée (--resync-mode newer)"

# 1. Sécurité anti-blocage : listes de référence préalables absentes du cache
# (premier lancement, ou invalidées suite à une erreur critique précédente).
# Un bisync standard échouerait obligatoirement : auto-récupération immédiate.
elif [ ! -d "$HOME/.cache/rclone/bisync" ] || \
     [ -z "$(find "$HOME/.cache/rclone/bisync" -maxdepth 1 -name "*.path1.lst" -print -quit 2>/dev/null)" ] || \
     [ -z "$(find "$HOME/.cache/rclone/bisync" -maxdepth 1 -name "*.path2.lst" -print -quit 2>/dev/null)" ]; then
    is_resync=1
    # Ne notifier d'une récupération automatique que si ce n'est PAS la toute première installation
    # (i.e. si un sync préalable avait déjà réussi, attesté par la présence de $STAMP).
    if [ -f "$STAMP" ]; then
        is_auto_resync=1
    fi
    reason="initialisation / auto-récupération (listes de référence absentes -> --resync-mode newer)"

# 2. Sync manuel forcé depuis le dashboard ?
elif [ -f "$FORCE_FILE" ]; then
    rm -f "$FORCE_FILE"
    reason="déclenchement manuel"

# 3. Un fichier local a-t-il changé dans la fenêtre [maintenant - fenêtre, maintenant] ?
elif [ -d "$SYNC_DIR" ] && \
     [ -n "$(find "$SYNC_DIR" -type f -newermt "$WIN_LO" ! -newermt "$WIN_HI" -print -quit 2>/dev/null)" ]; then
    reason="changement local détecté (< ${LOCAL_WINDOW} min)"

# 4. Filet de sécurité Cloud : sync complet périodique (si configuré)
elif [ "$FULL_INTERVAL" != "never" ] && [ "$FULL_INTERVAL" != "0" ] && [ "$FULL_INTERVAL" -gt 0 ] 2>/dev/null; then
    now=$(date +%s)
    last=0
    [ -f "$STAMP" ] && last=$(cat "$STAMP" 2>/dev/null || echo 0)
    if [ "$(( (now - last) / 60 ))" -ge "$FULL_INTERVAL" ]; then
        reason="filet cloud périodique (dernier > ${FULL_INTERVAL} min)"
    fi
fi

if [ -n "$reason" ]; then
    echo "RcloneDash: lancement du bisync — $reason"
    run_bisync "$is_resync" "$is_auto_resync"
    exit $?
fi

echo "RcloneDash: aucun changement local et filet cloud non échu — bisync ignoré"
exit 0
